{
  "name": "zmbackup",
  "version": "1.2.12",
  "scripts": {
    "test": "bats -j $(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 8) tests/unit/ tests/functional/",
    "test:unit": "bats -j $(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 8) tests/unit/",
    "test:functional": "bats -j $(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 8) tests/functional/",
    "lint": "shellcheck project/zmbackup project/lib/bash/*.sh installScript/*.sh"
  },
  "devDependencies": {
    "bats": "^1.13.0"
  }
}

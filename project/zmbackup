#!/bin/bash
################################################################################
# zmbackup - Enterprise Hot Backup & Restore for Zimbra Collaboration Suite
#            and Carbonio Community Edition
#
# Original Creator & Lead Architect: Lucas Costa Beyeler (based on Zmbkpose by bggo)
# Enterprise Optimization & Maintainer: Harry Dertin Sutisna Alsyundawy
#
# Copyright (c) 2016-2026 Lucas Costa Beyeler & Harry Dertin Sutisna Alsyundawy
# License: MIT License (see LICENSE)
################################################################################
umask 077

################################################################################
# LOADING ZMBACKUP LIBRARIES
################################################################################
# shellcheck source=/dev/null
source /usr/local/lib/zmbackup/bash/HelpAction.sh 2>/dev/null || source "$(dirname "${0}")/lib/bash/HelpAction.sh"
# shellcheck source=/dev/null
source /usr/local/lib/zmbackup/bash/MiscAction.sh 2>/dev/null || source "$(dirname "${0}")/lib/bash/MiscAction.sh"
# shellcheck source=/dev/null
source /usr/local/lib/zmbackup/bash/NotifyAction.sh 2>/dev/null || source "$(dirname "${0}")/lib/bash/NotifyAction.sh"
# shellcheck source=/dev/null
source /usr/local/lib/zmbackup/bash/ParallelAction.sh 2>/dev/null || source "$(dirname "${0}")/lib/bash/ParallelAction.sh"
# shellcheck source=/dev/null
source /usr/local/lib/zmbackup/bash/ListAction.sh 2>/dev/null || source "$(dirname "${0}")/lib/bash/ListAction.sh"
# shellcheck source=/dev/null
source /usr/local/lib/zmbackup/bash/BackupAction.sh 2>/dev/null || source "$(dirname "${0}")/lib/bash/BackupAction.sh"
# shellcheck source=/dev/null
source /usr/local/lib/zmbackup/bash/RestoreAction.sh 2>/dev/null || source "$(dirname "${0}")/lib/bash/RestoreAction.sh"
# shellcheck source=/dev/null
source /usr/local/lib/zmbackup/bash/DeleteAction.sh 2>/dev/null || source "$(dirname "${0}")/lib/bash/DeleteAction.sh"
# shellcheck source=/dev/null
source /usr/local/lib/zmbackup/bash/MigrationAction.sh 2>/dev/null || source "$(dirname "${0}")/lib/bash/MigrationAction.sh"
# shellcheck source=/dev/null
source /usr/local/lib/zmbackup/bash/SessionAction.sh 2>/dev/null || source "$(dirname "${0}")/lib/bash/SessionAction.sh"

################################################################################
# GLOBAL INITIALIZATION
################################################################################
load_config
validate_config
export_function
export_vars
constant

################################################################################
# CLI PARSING & ROUTING
################################################################################
case "${1}" in
"-f" | "--full")
	checkpid
	case "${2}" in
	"-dl" | "--distributionlist")
		validate_account_args "${3}" "${4}" || exit 2
		sessionvars "${2}"
		create_temp
		backup_main "${DLOBJECT}" "${DLFILTER}" "${3}" "${4}"
		rm -rf "${PID}"
		;;
	"-al" | "--alias")
		validate_account_args "${3}" "${4}" || exit 2
		sessionvars "${2}"
		create_temp
		backup_main "${ALOBJECT}" "${ALFILTER}" "${3}" "${4}"
		rm -rf "${PID}"
		;;
	"-ldp" | "--ldap")
		validate_account_args "${3}" "${4}" || exit 2
		sessionvars "${2}"
		create_temp
		backup_main "${ACOBJECT}" "${ACFILTER}" "${3}" "${4}"
		rm -rf "${PID}"
		;;
	"-m" | "--mail")
		validate_account_args "${3}" "${4}" || exit 2
		sessionvars "${2}"
		create_temp
		backup_main "${ACOBJECT}" "${ACFILTER}" "${3}" "${4}"
		rm -rf "${PID}"
		;;
	"-sig" | "--signature")
		validate_account_args "${3}" "${4}" || exit 2
		sessionvars "${2}"
		create_temp
		backup_main "${SIOBJECT}" "${SIFILTER}" "${3}" "${4}"
		rm -rf "${PID}"
		;;
	"-dom" | "--domain-backup")
		validate_account_args "${3}" "${4}" || exit 2
		sessionvars "${2}"
		create_temp
		backup_main "${DOMOBJECT}" "${DOMFILTER}" "${3}" "${4}"
		rm -rf "${PID}"
		;;
	*)
		validate_account_args "${2}" "${3}" || exit 2
		sessionvars "${1}"
		create_temp
		backup_main "${ACOBJECT}" "${ACFILTER}" "${2}" "${3}"
		rm -rf "${PID}"
		;;
	esac
	;;
"-i" | "--incremental")
	validate_account_args "${2}" "${3}" || exit 2
	sessionvars "${1}" 'TRUE'
	checkpid
	create_temp
	backup_main "${ACOBJECT}" "${ACFILTER}" "${2}" "${3}"
	rm -rf "${PID}"
	;;
"-l" | "--list")
	list_sessions "${2}"
	;;
"-c" | "--check-integrity")
	if [[ -z ${2} ]]; then
		show_help
		printf "\nError: Please provide the session ID to verify (e.g. zmbackup -c full-20260828110000)\n\n"
		exit 2
	fi
	check_session_integrity "${2}"
	ERRCODE=$?
	;;
"--health")
	system_health_check
	ERRCODE=$?
	;;
"-r" | "--restore")
	# Check for optional flags like --resolve, --rewrite-host, --dry-run
	shift
	RESTORE_FLAGS=()
	while [[ $# -gt 0 ]]; do
		case "${1}" in
		--resolve)
			RESTORE_RESOLVE_STRATEGY="${2}"
			export RESTORE_RESOLVE_STRATEGY
			shift 2
			;;
		--rewrite-host)
			if [[ ${2} =~ ^([^=]+)=([^=]+)$ ]]; then
				REWRITE_HOST_OLD="${BASH_REMATCH[1]}"
				REWRITE_HOST_NEW="${BASH_REMATCH[2]}"
				export REWRITE_HOST_OLD REWRITE_HOST_NEW
			fi
			shift 2
			;;
		--dry-run)
			DRY_RUN=true
			export DRY_RUN
			shift
			;;
		*)
			RESTORE_FLAGS+=("${1}")
			shift
			;;
		esac
	done

	set -- "${RESTORE_FLAGS[@]}"
	create_temp
	checkpid
	case "${1}" in
	"-dl" | "--distributionlist" | "-ldp" | "--ldap" | "-al" | "--alias" | "-sig" | "--signature")
		case "${2}" in
		"-a" | "--account" | "-d" | "--domain")
			if ! validate_session_id "${3}"; then
				printf "\n\nError! Invalid session ID: %s\n\n" "${3}"
				exit 2
			fi
			restore_main_ldap "${3}" "${4}"
			ERRCODE=$?
			;;
		*)
			if ! validate_session_id "${2}"; then
				printf "\n\nError! Invalid session ID: %s\n\n" "${2}"
				exit 2
			fi
			restore_main_ldap "${2}" "${3}"
			ERRCODE=$?
			;;
		esac
		rm -rf "${PID}"
		;;
	"-dom" | "--domain-backup")
		if ! validate_session_id "${2}"; then
			printf "\n\nError! Invalid session ID: %s\n\n" "${2}"
			exit 2
		fi
		restore_main_domain "${2}" "${3}"
		ERRCODE=$?
		rm -rf "${PID}"
		;;
	"-m" | "--mail")
		if ! validate_session_id "${2}"; then
			printf "\n\nError! Invalid session ID: %s\n\n" "${2}"
			exit 2
		fi
		restore_main_mailbox "${2}" "${3}" "${4}"
		ERRCODE=$?
		rm -rf "${PID}"
		;;
	"-ro" | "--restoreOnAccount")
		if [[ -z ${3} || -z ${4} ]]; then
			show_help
			printf "\n\nError! Please inform the account that should be restored, and destination account.\n\n"
			exit 2
		else
			if ! validate_session_id "${2}"; then
				printf "\n\nError! Invalid session ID: %s\n\n" "${2}"
				exit 2
			fi
			if ! validate_email "${3}"; then
				printf "\n\nError! Invalid email address: %s\n\n" "${3}"
				exit 2
			fi
			if ! validate_email "${4}"; then
				printf "\n\nError! Invalid email address: %s\n\n" "${4}"
				exit 2
			fi
			restore_main_mailbox "${2}" "${3}" "${4}"
			ERRCODE=$?
			rm -rf "${PID}"
		fi
		;;
	*)
		if [[ ${1} == "full"* || ${1} == "inc"* ]]; then
			if ! validate_session_id "${1}"; then
				printf "\n\nError! Invalid session ID: %s\n\n" "${1}"
				exit 2
			fi
			restore_main_ldap "${1}" "${2}" "${3}"
			ERRCODE=$?
			restore_main_mailbox "${1}" "${2}" "${3}" || ERRCODE=$?
			rm -rf "${PID}"
		else
			show_help
			printf "\n\nError! Invalid parameters for restore\n"
		fi
		;;
	esac
	;;
"-d" | "--delete")
	if [[ -z ${2} ]]; then
		show_help
		printf "\n\nError! Please inform the session that should be deleted\n\n"
	else
		if ! validate_session_id "${2}"; then
			printf "\n\nError! Invalid session ID: %s\n\n" "${2}"
			exit 2
		fi
		checkpid
		delete_one "${2}"
		ERRCODE=$?
		rm -rf "${PID}"
	fi
	;;
"-hp" | "--housekeep")
	checkpid
	delete_old
	clean_empty
	rm -rf "${PID}"
	;;
"-t" | "--truncate")
	if [[ -n ${2} && ${2} == "--force-clean" ]]; then
		checkpid
		leeroy_jenkins
		clean_empty
		rm -rf "${PID}"
	else
		echo "This action is irreversible - Use the option --force-clean to override this message"
	fi
	;;
"-h" | "--help")
	show_help
	;;
"-v" | "--version")
	VERSION_STR=$(cat /usr/local/lib/zmbackup/VERSION 2>/dev/null || cat "$(dirname "${0}")/../VERSION" 2>/dev/null || echo "1.2.12") || true
	echo "zmbackup version: ${VERSION_STR}"
	;;
"-mg" | "--migrate")
	checkpid
	migration
	rm -rf "${PID}"
	;;
*)
	show_help
	printf "\n\nError! Incorrect options\n\n"
	;;
esac
exit "${ERRCODE:-0}"
